<!-- =========================================================
======================== style.css ==========================
SAVE AS: style.css
========================================================= -->

/* =========================
COLOR VARIABLES
Change these colors to customize theme
========================= */

:root {
  --forest-green: #2f5d3f;
  --brown: #7b5e3b;
  --light-blue: #d9eef7;
  --white: #ffffff;
  --light-bg: #f5f7f6;
  --dark-text: #1f2937;
  --border: #d8e2dc;
}

/* =========================
GLOBAL STYLES
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: var(--light-bg);
  color: var(--dark-text);
  line-height: 1.6;
}

/* =========================
HEADER / NAVIGATION
========================= */

header {
  background: var(--forest-green);
  color: white;
  padding: 1rem 2rem;
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* ==========================================
CHANGE LOGO IMAGE SIZE HERE
========================================== */

.logo {
  width: 70px;
  height: 70px;
  border-radius: 50%;
}

nav {
  margin-top: 1rem;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  gap: 1rem;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  color: var(--light-blue);
}

/* =========================
HERO SECTION
========================= */

.hero {
  padding: 4rem 2rem;
  text-align: center;
  background: var(--light-blue);
}

.hero h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

/* =========================
MAIN CONTENT
========================= */

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
  padding: 2rem 0;
}

.card {
  background: white;
  padding: 1.5rem;
  margin-bottom: 2rem;
  border-radius: 10px;
  border: 1px solid var(--border);
}

/* =========================
IMAGES
========================= */

.feature-image {
  width: 100%;
  border-radius: 10px;
  margin-top: 1rem;
}

/* =========================
TABLE
========================= */

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1rem;
}

th {
  background: var(--forest-green);
  color: white;
}

th, td {
  padding: 1rem;
  border: 1px solid #ccc;
}

/* =========================
FORM
========================= */

form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

input,
textarea,
button {
  padding: 0.8rem;
  border-radius: 5px;
  border: 1px solid #ccc;
}

button {
  background: var(--forest-green);
  color: white;
  border: none;
  cursor: pointer;
}

button:hover {
  background: var(--brown);
}

/* =========================
FOOTER
========================= */

footer {
  background: var(--forest-green);
  color: white;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}

/* =========================
RESPONSIVE DESIGN
========================= */

@media (max-width: 768px) {

  nav ul {
    flex-direction: column;
  }

  .hero h1 {
    font-size: 2rem;
  }
}

