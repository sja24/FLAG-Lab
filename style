:root {
  --forest-green: #2f5d3f;
  --brown: #7b5e3b;
  --light-blue: #d9eef7;
  --dark-text: #1f2937;
  --light-bg: #f7faf9;
  --white: #ffffff;
  --border: #d7e2dc;
  --shadow: 0 4px 12px rgba(0,0,0,0.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Inter", sans-serif;
  background-color: var(--light-bg);
  color: var(--dark-text);
  line-height: 1.6;
}

.navbar {
  background-color: var(--forest-green);
  color: white;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  }
  
  .logo {
    font-size: 1.4rem;
    font-weight: bold;
  }
  
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  
  .nav-links a:hover {
    color: var(--light-blue);
  }
  
  .hero {
    background: linear-gradient(
        rgba(47, 93, 63, 0.85),
        rgba(47, 93, 63, 0.85)
      ),
      url("https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1400&q=80");
  
    background-size: cover;
    background-position: center;
    color: white;
    text-align: center;
    padding: 5rem 2rem;
}

.hero h1 {
  font-size: 3rem;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
  padding: 2rem 0;
}

.card {
  background: white;
  padding: 1.5rem;
  margin-bottom: 2rem;
  border-radius: 14px;
  box-shadow: var(--shadow);
}

.section-title {
  margin-bottom: 1rem;
  color: var(--forest-green);
}

.feature-image {
  width: 100%;
  border-radius: 12px;
  margin-top: 1rem;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 1rem;
  border: 1px solid #ddd;
}

th {
  background: var(--forest-green);
  color: white;
}

form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

input,
textarea,
button {
  padding: 0.8rem;
  border-radius: 6px;
  border: 1px solid #ccc;
}

button {
  background: var(--forest-green);
  color: white;
  border: none;
  cursor: pointer;
}

button:hover {
  background: var(--brown);
}

footer {
  background: var(--forest-green);
  color: white;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}

@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 1rem;
  }

  .nav-links {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero h1 {
    font-size: 2rem;
  }
}
