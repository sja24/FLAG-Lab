<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GreenSeed Plant Breeding Lab</title>

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --forest-green: #2f5d3f;
      --brown: #7b5e3b;
      --light-blue: #d9eef7;
      --dark-text: #1f2937;
      --light-bg: #f7faf9;
      --white: #ffffff;
      --border: #d7e2dc;
      --shadow: 0 4px 12px rgba(0,0,0,0.08);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Inter", sans-serif;
      background-color: var(--light-bg);
      color: var(--dark-text);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* ================= NAVBAR ================= */

    .navbar {
      background-color: var(--forest-green);
      color: white;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 700;
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
    }

    .nav-links a {
      font-weight: 500;
      transition: 0.3s;
    }

    .nav-links a:hover,
    .nav-links a:focus {
      color: var(--light-blue);
    }

    /* ================= HERO ================= */

    .hero {
      background: linear-gradient(
        rgba(47, 93, 63, 0.85),
        rgba(47, 93, 63, 0.85)
      ),
      url("https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=1400&q=80");
      background-size: cover;
      background-position: center;
      color: white;
      padding: 5rem 2rem;
      text-align: center;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .hero p {
      max-width: 800px;
      margin: auto;
      font-size: 1.1rem;
    }

    /* ================= LAYOUT ================= */

    .container {
      display: grid;
      grid-template-columns: 250px 1fr;
      min-height: 100vh;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
      background-color: var(--brown);
      color: white;
      padding: 2rem 1rem;
    }

    .sidebar h2 {
      margin-bottom: 2rem;
      font-size: 1.2rem;
    }

    .sidebar ul {
      list-style: none;
    }

    .sidebar li {
      margin-bottom: 1rem;
    }

    .sidebar a {
      display: block;
      padding: 0.75rem;
      border-radius: 8px;
      transition: 0.3s;
    }

    .sidebar a:hover,
    .sidebar a:focus {
      background-color: rgba(255,255,255,0.15);
    }

    /* ================= MAIN CONTENT ================= */

    .main-content {
      padding: 2rem;
    }

    .section-title {
      margin-bottom: 1.5rem;
      color: var(--forest-green);
      font-size: 1.8rem;
    }

    /* ================= KPI CARDS ================= */

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .card {
      background-color: var(--white);
      border-radius: 14px;
      padding: 1.5rem;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .card h3 {
      color: var(--forest-green);
      margin-bottom: 0.5rem;
    }

    .kpi-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--brown);
    }

    /* ================= CHARTS ================= */

    .chart-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    canvas {
      width: 100% !important;
      height: 300px !important;
    }

    /* ================= TABLE ================= */

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background-color: white;
      border-radius: 12px;
      overflow: hidden;
    }

    th, td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      background-color: var(--forest-green);
      color: white;
    }

    tr:hover {
      background-color: #f0f7f3;
    }

    /* ================= ABOUT SECTION ================= */

    .about-section {
      margin-top: 3rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .about-box {
      background-color: white;
      padding: 1.5rem;
      border-radius: 14px;
      box-shadow: var(--shadow);
    }

    .about-box h3 {
      color: var(--forest-green);
      margin-bottom: 1rem;
    }

    /* ================= FOOTER ================= */

    footer {
      background-color: var(--forest-green);
      color: white;
      text-align: center;
      padding: 1rem;
      margin-top: 3rem;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 900px) {
      .container {
        grid-template-columns: 1fr;
      }

      .sidebar {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .sidebar ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
      }
    }

    @media (max-width: 600px) {
      .hero h1 {
        font-size: 2rem;
      }

      .navbar {
        flex-direction: column;
        gap: 1rem;
      }

      .nav-links {
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>

<body>

  <!-- ================= NAVBAR ================= -->

  <nav class="navbar" aria-label="Main navigation">
    <div class="logo">GreenSeed Research Lab</div>

    <div class="nav-links">
      <a href="#dashboard">Dashboard</a>
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="#history">History</a>
    </div>
  </nav>

  <!-- ================= HERO ================= -->

  <section class="hero">
    <h1>Fields Lab and Genetics</h1>
    <p>
      Advancing sustainable agriculture through innovative plant genetics,
      crop resilience research, and collaborative breeding programs.
    </p>
  </section>

  <!-- ================= MAIN LAYOUT ================= -->

  <div class="container">

    <!-- SIDEBAR -->

    <aside class="sidebar">
      <h2>Lab Navigation</h2>

      <ul>
        <li><a href="#dashboard">Research Overview</a></li>
        <li><a href="#projects">Current Projects</a></li>
        <li><a href="#analytics">Analytics</a></li>
        <li><a href="#about">Mission</a></li>
        <li><a href="#history">Lab History</a></li>
      </ul>
    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

      <!-- DASHBOARD -->

      <section id="dashboard">
        <h2 class="section-title">Research Dashboard</h2>

        <div class="kpi-grid">

          <div class="card">
            <h3>Active Projects</h3>
            <div class="kpi-number">12</div>
          </div>

          <div class="card">
            <h3>Crop Varieties Tested</h3>
            <div class="kpi-number">48</div>
          </div>

          <div class="card">
            <h3>Research Partners</h3>
            <div class="kpi-number">9</div>
          </div>

          <div class="card">
            <h3>Field Sites</h3>
            <div class="kpi-number">17</div>
          </div>

        </div>
      </section>

      <!-- CHARTS -->

      <section id="analytics">
        <h2 class="section-title">Research Analytics</h2>

        <div class="chart-grid">

          <div class="card">
            <h3>Crop Improvement Progress</h3>
            <canvas id="lineChart"></canvas>
          </div>

          <div class="card">
            <h3>Research Allocation</h3>
            <canvas id="pieChart"></canvas>
          </div>

        </div>
      </section>

      <!-- PROJECT TABLE -->

      <section id="projects">
        <h2 class="section-title">Current Projects</h2>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Project</th>
                <th>Focus Area</th>
                <th>Status</th>
                <th>Lead Researcher</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Tannin Effect Research</td>
                <td>Removal for Animal Consumption</td>
                <td>Active</td>
                <td> Dr. Iyakaremye</td>
              </tr>

              <tr>
                <td>High-Yield Soybean Lines</td>
                <td>Yield Optimization</td>
                <td>Field Trials</td>
                <td>Dr. Fields</td>
              </tr>

              <tr>
                <td>NIR Analysis</td>
                <td>Seed Composition Analysis</td>
                <td>Analysis</td>
                <td>Dr. Nguyen</td>
              </tr>

              <tr>
                <td>RNA Sequencing</td>
                <td>Extraction</td>
                <td>RNA Isolation</td>
                <td>MS. Johnson</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ABOUT -->

      <section id="about" class="about-section">

        <div class="about-box">
          <h3>Our Mission</h3>

          <p>
            The Fields Lab of Research and Genetics is dedicated to
            improving global food security and advancing student 
            understanding through innovative crop genetics,
            sustainable agricultural practices, and collaborative research.
          </p>
        </div>

        <div class="about-box">
          <h3>Current Research</h3>

          <p>
            Our team studies drought resistance, disease tolerance,
            crop yield optimization, and sustainable breeding methods
            using both traditional and modern genomic approaches.
          </p>
        </div>

      </section>

      <!-- HISTORY -->

      <section id="history" class="about-section">

        <div class="about-box">
          <h3>Lab History</h3>

          <p>
            Founded in 2022, the lab began as a regional crop genetics
            initiative and has since expanded into an interdisciplinary
            research center collaborating with universities and agricultural
            organizations nationally.
          </p>
        </div>

        <div class="about-box">
          <h3>Future Goals</h3>

          <p>
            We aim to develop climate-resilient crop systems that improve
            sustainability, explore the integration of underutilized
            herbs into animal production, and support farmers facing
            changing agricultural conditions.
          </p>
        </div>

      </section>

    </main>
  </div>

  <!-- FOOTER -->

  <footer>
    <p>© 2026 Fields Lab of Research and Genetics</p>
  </footer>

  <!-- ================= CHART.JS ================= -->

  <script>
    // Line Chart

    const lineCtx = document.getElementById('lineChart');

    new Chart(lineCtx, {
      type: 'line',
      data: {
        labels: ['2022', '2023', '2024', '2025', '2026'],
        datasets: [{
          label: 'Improved Crop Yield (%)',
          data: [10, 18, 25, 32, 45],
          borderColor: '#2f5d3f',
          backgroundColor: 'rgba(47, 93, 63, 0.2)',
          fill: true,
          tension: 0.4
        }]
      }
    });

    // Pie Chart

    const pieCtx = document.getElementById('pieChart');

    new Chart(pieCtx, {
      type: 'doughnut',
      data: {
        labels: [
          'Cowpea',
          'Soybean',
          'Corn',
          'Wheat'
        ],

        datasets: [{
          data: [35, 25, 20, 20],
          backgroundColor: [
            '#2f5d3f',
            '#7b5e3b',
            '#8ecae6',
            '#95d5b2'
          ]
        }]
      }
    });
  </script>

</body>
</html>
